{
  "name": "bpm-opencode-experts",
  "version": "2.37.0",
  "license": "Apache-2.0",
  "description": "SDLC expert-agent system for opencode — specialist agents, shared protocols, and validators.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmforge/bpm-opencode-experts.git"
  },
  "type": "module",
  "dependencies": {
    "@opencode-ai/plugin": "1.4.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.59.1",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types scripts/test.ts",
    "check": "npm test",
    "agents:check": "node scripts/build-agents.mjs --check",
    "agents:fix": "node scripts/build-agents.mjs --fix",
    "agents:compact": "node scripts/build-agents.mjs --compact",
    "build:claude": "node scripts/build-target-claude.mjs --write",
    "build:claude:check": "node scripts/build-target-claude.mjs --check",
    "evals": "node scripts/run-evals.mjs",
    "evals:agent": "node scripts/run-evals.mjs --agent",
    "evals:compare": "node scripts/eval-compare.mjs",
    "evals:status": "node scripts/eval-status.mjs",
    "evals:compare:selftest": "node scripts/eval-compare.mjs --self-test",
    "telemetry:report": "node scripts/telemetry-report.mjs"
  }
}
