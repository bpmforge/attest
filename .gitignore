# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env / secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
*.p12
*.pfx

# Local agent state (per-user, not shared)
.claude/agent-memory/

# Code search index (per-user, generated)
.code-search/

# Local model context (per-user)
docs/work/.model-context

# Eval results (per-run, tier-stamped)
docs/work/EVAL_RESULTS.json

# Telemetry actuals (per-machine, append-only) -- validators write this
# under any project root they're pointed at, including fixture dirs under
# evals/fixtures/validators/, so this must be recursive, not root-anchored.
**/docs/work/telemetry.jsonl

# Watchdog kill checkpoints (T31.5, per-run, append-only) -- run-until-done.sh
# writes this under any --root it's pointed at, same reasoning as telemetry above.
**/docs/work/watchdog-events.jsonl

# Session model receipts (T30.2, per-machine, append-only) -- same shape and
# reasoning as telemetry above: session ids and model pins from THIS machine's
# runs, meaningless in anyone else's checkout.
**/docs/work/session-receipts.jsonl

# Blind-grading answer key -- deliberately NOT committed. BENCH_BLIND_PACKET.md
# is committed as evidence, but committing the key that maps candidate A/B back
# to model names would foreclose re-grading that packet blind. Regenerate it
# with scripts/bench-model-compare.mjs when you need it.
docs/work/BENCH_BLIND_KEY.json

# Generated expert reports (per-project outputs)
docs/reviews/
docs/security/
docs/git/
docs/research/
docs/design/
docs/perf/
docs/threat/
docs/test/
docs/db/

# Runtime logs
*.log
logs/
.opencode-loops/

# Artifacts of running `./install.sh --project` from inside this checkout
/.opencode/
/opencode.json

# Executor worktrees + validator/test scratch dirs (never committed)
.worktrees/
.tmp-wd-*/
.tmp-*/
.tmp-realworld/
docs/work/realworld-runs/
